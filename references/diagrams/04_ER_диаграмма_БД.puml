  +is_active : boolean
  +created_at : timestamptz
   last_login_at : timestamptz
}
entity "people" as people {
  *id : uuid <<PK>>
  +company_id : uuid <<FK>>
   account_id : uuid <<FK>>
  +full_name : text
   job_title : text
  +status : text
  +created_at : timestamptz
}
entity "memberships" as memberships {
  *id : uuid <<PK>>
  +company_id : uuid <<FK>>
  +person_id : uuid <<FK>>
  +active : boolean
  +joined_at : timestamptz
   disabled_at : timestamptz
}
