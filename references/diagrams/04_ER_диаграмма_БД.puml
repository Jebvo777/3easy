title EASY3 — логическая схема данных
entity "companies" as companies {
  *id : uuid <<PK>>
  +name : text
  +currency : char3
  +timezone : text
  +status : text
  +created_at : timestamptz
  +updated_at : timestamptz
}
entity "accounts" as accounts {
  *id : uuid <<PK>>
  +email : text
