@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
start
:Выбрать компанию или создать паспорт;
:Создать черновик заказа;
if (Достаточно данных для оценки?) then (да)
  :Собрать / импортировать технологию;
else (нет)
  :Попросить недостающие данные;
  :Продолжить как неполный черновик;
endif
:Проверить нормы и ограничения;
if (План выполним?) then (да)
  :Подтвердить версию;
  :Бригадир назначает исполнителей;
  :Выдать задания;
  :Получить событие выполнения;
  :Провести ОТК;
  if (Есть доработка?) then (да)
    :Вернуть работу в выполнение;
  else (нет)
    :Обновить годный выпуск;
  endif
  :Пересчитать остаток, сроки и экономику;
  if (Есть отклонение?) then (да)
    :Предложить сценарии без применения;
    :Принять решение о новой версии;
  endif
else (нет)
  :Показать конкретное ограничение;
  :Изменить план или входные данные;
endif
stop
@enduml
